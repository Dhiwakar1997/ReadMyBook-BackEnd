  "editor.tokenColorCustomizations": {
    "[*Dark*]": {
      "variables": "#f46469",
      "functions": "#00bfff",
      "strings": "#f6ec5b",
      "comments": "#456281",
      "keywords": "#eb3cb4",
      "types": "#00bfff",
      "numbers": "#ffffff"
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[*Dark*]": {
      "enabled": true,
      "rules": {
        "type": "#00bfff",
        "namespace": "#ef4141",
        "functions": "#00bfff",
        "variable": "#f46469",
        "number": "#e8e153",
        "variable.readonly.defaultLibrary": "#ffa37c",
        "macro": "#7E57C2",
        "keyword": "#eb3cb4",
        "operator": "#74d3cf",
        "type.modification": "#ec63ea",
        "punctuation": "#7ee7e4",
        "parameter": "#54ff7f",
        "string": {
          "foreground": "#f6ec5b",
          "italic": true
        },
        "comment": {
          "foreground": "#456281",
          "fontStyle": "italic"
        }
      }
    }
  },

