FROM python:3.11-slim

# -------------------------
# Environment
# -------------------------
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Disable HF telemetry & online checks
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV HF_HUB_OFFLINE=1

# IMPORTANT: marker/surya cache locations
ENV DATALAB_CACHE_DIR=/root/.cache/datalab
ENV TORCH_HOME=/root/.cache/torch

# -------------------------
# System dependencies
# -------------------------
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    poppler-utils \
    tesseract-ocr \
    libtesseract-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# -------------------------
# Working directory
# -------------------------
WORKDIR /app

# -------------------------
# Python dependencies
# -------------------------
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# -------------------------
# Pre-download models (ACR SAFE)
# -------------------------
COPY workerDependencies.py .
RUN python workerDependencies.py

# -------------------------
# Application code
# -------------------------
COPY . .

CMD ["python", "worker.py"]